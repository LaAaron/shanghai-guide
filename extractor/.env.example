# Copy this file to .env (same folder) and paste your keys after the = signs. .env is never committed.
ANTHROPIC_API_KEY=
APIFY_TOKEN=

# Optional tuning (defaults shown)
# FRAME_EVERY=1.5      seconds between video frames
# FRAME_SIZE=512       long side of each frame in pixels
# MAX_FRAMES=80        long videos are sampled more thinly to stay under this

# Optional: use different Apify actors or add input fields (JSON merged into the default input)
# APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
# APIFY_INSTAGRAM_INPUT={"resultsLimit":1}
# APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
# APIFY_TIKTOK_INPUT={}
# APIFY_WEB_ACTOR=apify/website-content-crawler
